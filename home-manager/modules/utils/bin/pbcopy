#!/usr/bin/env bash
#
# Copies stdin to the system clipboard of the machine the user is looking at.
#
# A local macOS session uses the system pbcopy. Everywhere else (Linux, SSH sessions) the text
# is sent as an OSC 52 escape sequence to the controlling terminal, which herdr-app turns into a
# local clipboard write. No clipboard tool or ssh hop is needed on the remote machine.
#
# PBCOPY_TTY overrides the terminal device (tests only).

set -euo pipefail

# Largest base64 payload herdr-app accepts as one OSC 52 write
max_payload=1048576
tty="${PBCOPY_TTY:-/dev/tty}"

if [[ "$(uname)" == "Darwin" && -z "${SSH_CONNECTION:-}" ]]; then
  if command -v reattach-to-user-namespace >/dev/null; then
    exec reattach-to-user-namespace /usr/bin/pbcopy
  fi
  exec /usr/bin/pbcopy
fi

payload=$(base64 | tr -d '\n')

if ((${#payload} > max_payload)); then
  echo "pbcopy: input is too large for an OSC 52 copy (${#payload} base64 bytes, limit ${max_payload})" >&2
  exit 1
fi

if ! printf '\033]52;c;%s\a' "$payload" >"$tty" 2>/dev/null; then
  echo "pbcopy: no terminal to write to ($tty); OSC 52 copy needs an interactive terminal such as an hc terminal in herdr-app" >&2
  exit 1
fi
